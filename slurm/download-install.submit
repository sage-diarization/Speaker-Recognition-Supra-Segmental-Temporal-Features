#!/bin/bash

# Small venv for the dataset download jobs (slurm/voxceleb*-download.submit):
# only the Hugging Face CLI, not the experiment's requirements.txt (see
# slurm/install.submit). Jobs pip-install further tools into it on demand.

CWD=$(pwd)

export PYTHON_VERSION="3.13.12"
export VENV_PATH="$CWD/.venv-download"

if [ -d "$VENV_PATH/bin" ]; then
    echo "Activating $VENV_PATH..."
    source "$VENV_PATH/bin/activate"
else
    echo "Creating VENV $VENV_PATH..."
    module load python/$PYTHON_VERSION
    virtualenv $VENV_PATH
    source "$VENV_PATH/bin/activate"
    unset PIP_TARGET
    unset PYTHONPATH

    echo "Install dependencies..."
    pip3 install "huggingface_hub[hf_xet]"
fi

python --version
