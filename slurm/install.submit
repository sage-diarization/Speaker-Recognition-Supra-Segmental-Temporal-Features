#!/bin/bash

export PYTHON_VERSION="3.13.12"

module load python/$PYTHON_VERSION
VENV=sst module load uv

echo "Sync dependencies..."
uv sync --frozen
# Activate so the submit scripts' plain `python3`/`wandb` calls use the venv.
source "$(uv run --frozen python -c 'import sys; print(sys.prefix)')/bin/activate"

python --version
nvidia-smi || rocm-smi

CWD=$(pwd)
