#!/bin/bash
#SBATCH --time=180
#SBATCH --job-name=sst-experiment_resnet
#SBATCH --ntasks=1
#SBATCH --nodes=1
#SBATCH --gres=gpu:1
#SBATCH --account=cai_cv
#SBATCH --partition=gpu_top
#SBATCH --output=logs/%j_%N__ex02.out
#SBATCH --error=logs/%j_%N__ex02.out

PYTHON_VERSION="3.13.12"
PYTHON_VENV="sst_experiment_cnn"

VENV_BASE_DIR="/raid/persistent_scratch/$USER/venvs"
VENV_PATH="$VENV_BASE_DIR/$PYTHON_VENV"

# rm -Rf $VENV_PATH
mkdir -p $VENV_BASE_DIR

if [ -d "$VENV_PATH" ]; then
    echo "Activating VENV $PYTHON_VENV..."
    source "$VENV_PATH/bin/activate"
else
    echo "Creating VENV $PYTHON_VENV..."
    module load python/$PYTHON_VERSION
    virtualenv $VENV_PATH
    source "$VENV_PATH/bin/activate"
    unset PIP_TARGET
    unset PYTHONPATH

    echo "Install dependencies..."
    pip3 install -r requirements.txt
fi

python --version
nvidia-smi

source slurm/secrets.submit

echo "Start experiment..."
wandb login $WANDB_API_KEY
python3 -u -m src.experiment --config configs/resnet_timit-hpc.yaml

echo "Done."
