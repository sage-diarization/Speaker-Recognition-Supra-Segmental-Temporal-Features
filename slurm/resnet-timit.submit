#!/bin/bash
#SBATCH --time=180
#SBATCH --job-name=sst-experiment_resnet
#SBATCH --ntasks=1
#SBATCH --nodes=1
#SBATCH --gres=gpu:1
#SBATCH --account=cai_cv
#SBATCH --partition=gpu_top
#SBATCH --output=logs/%j_%N__ex02.out
#SBATCH --error=logs/%j_%N__ex02.out

source slurm/install.submit
source slurm/secrets.submit

echo "Start experiment..."
wandb login $WANDB_API_KEY
python3 -u -m src.experiment --config configs/resnet_timit-hpc.yaml

echo "Done."
