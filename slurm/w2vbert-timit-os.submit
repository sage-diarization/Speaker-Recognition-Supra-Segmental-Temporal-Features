#!/bin/bash
#SBATCH --time=720
#SBATCH --job-name=sst/w2vbert-timit-os
#SBATCH --ntasks=1
#SBATCH --nodes=1
#SBATCH --gres=gpu:1
#SBATCH --account=cai_cv
#SBATCH --partition=gpu_top
#SBATCH --exclude=irvine
#SBATCH --output=logs/%j_%N.out
#SBATCH --error=logs/%j_%N.out

source slurm/install.submit
source slurm/secrets.submit

# install.submit only installs requirements.txt into a new venv; an existing
# one may predate the transformers dependency of the W2VBert model.
python3 -c "import transformers" 2>/dev/null || pip3 install transformers

echo "Start experiment..."
wandb login $WANDB_API_KEY
python3 -u -m src.experiment \
	--config configs/w2vbert-timit.yaml \
	--strategy OS

echo "Done."
